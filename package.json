{
  "name": "opencode-pets",
  "version": "0.0.0",
  "description": "OpenCode plugin installer for OpenPets desktop pet status updates.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvinunreal/opencode-pets.git"
  },
  "keywords": [
    "opencode",
    "openpets",
    "plugin",
    "desktop-pet",
    "bun",
    "typescript",
    "ai-agents",
    "local-first"
  ],
  "bin": {
    "opencode-pets": "./src/cli.ts"
  },
  "dependencies": {
    "@openpets/client": "file:../openpets/packages/client",
    "@openpets/core": "file:../openpets/packages/core"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "bun run typecheck",
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit"
  }
}
